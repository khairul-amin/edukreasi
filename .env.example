# Core server config
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-public-anon-key
# Must match the active production domain used by browser clients.
PUBLIC_BASE_URL=https://edukreasi.my.id

# App downloads (Cloudflare R2)
# Public download base URL (custom domain recommended, e.g. https://download.edukreasi.my.id).
APP_RELEASE_PUBLIC_BASE_URL=https://download.edukreasi.my.id
# R2 bucket name for releases.
APP_RELEASE_BUCKET=releases
# If it ends with .apk/.exe/.zip/.rar -> fixed filename (link always the same).
# If it is a folder name -> versioned filename (link follows uploaded filename).
APP_STUDENT_APK_PATH=student
APP_ADMIN_EXE_PATH=admin
# Cloudflare R2 S3 API credentials
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Optional override. Defaults to https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# License token signing
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
LICENSE_PLAN=full
LICENSE_PRICE=250000
LICENSE_CURRENCY=IDR
LICENSE_ACTIVATION_LIMIT=1

# Midtrans
MIDTRANS_MERCHANT_ID=Gxxxxxxxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=0
